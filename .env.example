# PostgreSQL (set automatically by Replit DB provisioning)
DATABASE_URL=postgresql://user:password@localhost:5432/jobgenie

# Admin panel protection
ADMIN_TOKEN=change-me-to-a-strong-random-string

# Anthropic AI (set automatically by Replit AI Integrations — do not set manually)
# AI_INTEGRATIONS_ANTHROPIC_BASE_URL=https://...
# AI_INTEGRATIONS_ANTHROPIC_API_KEY=dummy

# Reddit API (create an app at https://www.reddit.com/prefs/apps — choose "script" type)
REDDIT_CLIENT_ID=your_reddit_client_id
REDDIT_CLIENT_SECRET=your_reddit_client_secret
REDDIT_USERNAME=YourRedditUsername

# Loop 1 tuning (all optional — defaults shown)
LOOP1_CRON="0 3 * * *"         # 3 AM daily
LOOP1_MAX_QUESTIONS=10          # Max new questions per run
LOOP1_COST_BUDGET_USD=2.00      # Max $ spend per run
LOOP1_QUALITY_THRESHOLD=7.0     # Min score (0–10) to publish
LOOP1_SUBREDDITS=jobs,jobsearchhacks,careerguidance,resumes,recruitinghell
